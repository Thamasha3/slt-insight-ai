# Copy this file to ".env" and fill in real values.
# Never commit the actual ".env" file.

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=insight_ai

# ---- JWT ----
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---- Admin restriction ----
# ONLY these two emails may ever hold the ADMIN role.
# Get the real addresses from SLT. Do not invent them for production.
ADMIN_EMAIL_1=dora@slt.com.lk
ADMIN_EMAIL_2=admin2@slt.com.lk

# ---- Gemini / Vertex AI (Phase 8) ----
# SLT uses Gemini 2.5 Flash on Vertex AI, location = global.
# Put the service-account JSON OUTSIDE git. Never send it to the React app.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LOCATION=global
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional Google AI Studio key (only if SLT later approves this path):
GEMINI_API_KEY=

# ---- App ----
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
